<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>mx.tlalocan.alerta</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__CARPETA__/alerta.py</string>
  </array>
  <key>WorkingDirectory</key><string>__CARPETA__</string>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__CARPETA__/logs/alerta.log</string>
  <key>StandardErrorPath</key><string>__CARPETA__/logs/alerta.log</string>
</dict>
</plist>
